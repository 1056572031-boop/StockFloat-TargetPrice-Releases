{
  "name": "skyrocket-feedback-retention",
  "main": "src/retention-worker.mjs",
  "compatibility_date": "2026-10-19",
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "GITHUB_APP_ID": "",
    "GITHUB_INSTALLATION_ID": "",
    "GITHUB_RELEASE_ID": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "skyrocket-feedback-budget",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
