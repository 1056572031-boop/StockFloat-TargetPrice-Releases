#!/usr/bin/env bash
# 实时股价 本地强制检查关卡（v1.2.28 第3项）
# 提交前自动执行：py_compile（语法校验） + ./run_tests.sh（全量测试）
# 任一失败即非零退出，阻止本次提交。
# 安装：git init 后运行 ./git-hooks/install-hooks.sh 即可启用。
set -euo pipefail

# 优先使用工程内 .venv（Python 3.14.10）解释器，避免误用系统 3.9 导致导入失败。
REPO_ROOT="$(git rev-parse --show-toplevel)"
VENV_PY="$REPO_ROOT/.venv/bin/python3"
if [ ! -x "$VENV_PY" ]; then
  echo "!! [pre-commit] 未找到工程内虚拟环境解释器：.venv/bin/python3" >&2
  echo "!! [pre-commit] 请先重建 .venv（Python 3.14.10），依赖见 requirements.txt 头部注释" >&2
  exit 1
fi
PY="$VENV_PY"
echo "== [pre-commit] 使用解释器: $PY ($("$PY" --version 2>&1)) =="

echo "== [pre-commit] 语法检查 py_compile =="
# 排除 .venv/.pyenvs（第三方依赖）、build/dist（生成物）等目录：
# 只校验项目自有源码；且 .venv 深层文件名过长，py_compile 写 __pycache__ 会触发
# macOS 文件名上限，误报 [Errno 2] 阻断提交。
find . -name '*.py' \
  -not -path './backups/*' -not -path './.git/*' \
  -not -path './.venv/*' -not -path './.pyenvs/*' \
  -not -path './build/*' -not -path './dist/*' \
  -not -path '*/__pycache__/*' -print0 \
  | xargs -0 "$PY" -m py_compile \
  || { echo "!! [pre-commit] py_compile 失败：存在语法错误，已阻止提交"; exit 1; }
echo "== [pre-commit] py_compile 通过 =="

# BEGIN lanes_default（tests/test_lane_runner.py 把这一段抽出来逐个环境值验证）
# 提交检查默认走并行车道（用户 2026-10-26 决定）。调用者已经设置了 SF_LANES 就原样尊重：
# SF_LANES=0 或 SF_LANES= 强制串行，SF_LANES=3 指定三条。没设置时由 auto_lanes() 按上一轮
# 实测工作量推导（发现失败退回核数公式），取不到、不是数字或少于 2 条就留空，走原来的串行路径。
if [ -z "${SF_LANES+x}" ]; then
  SF_LANES="$("$PY" -c 'import sys; sys.path.insert(0, sys.argv[1]); import lane_runner; print(lane_runner.auto_lanes())' "$REPO_ROOT/tools" 2>/dev/null)" || SF_LANES=""
  case "$SF_LANES" in ""|*[!0-9]*|0|1) SF_LANES="" ;; esac
fi
export SF_LANES
# END lanes_default
echo "== [pre-commit] 并行车道: ${SF_LANES:-关闭（串行）} =="

# 2026-11-02 走查 F-J-03：这三个是 run_tests.sh 留给测试用的短路开关（探针模式下取到守卫/锁就
# exit 0、一条用例不跑、不落关卡戳）。shell 里残留一个，钩子就会对着零用例打印“允许提交”，
# 所以真正的提交关卡调用前必须洗掉；测试里直接调 run_tests.sh 的探针用例自己设变量，不经这里。
unset SF_GUARD_PROBE SF_LOCK_PROBE SF_LOCK_PROBE_DIR

echo "== [pre-commit] 运行发版测试关卡 run_tests.sh =="
./run_tests.sh \
  || { echo "!! [pre-commit] 测试未通过，已阻止提交（请先修复并重跑 ./run_tests.sh 通过后再提交）"; exit 1; }

echo "== [pre-commit] 全部检查通过，允许提交 =="
exit 0
